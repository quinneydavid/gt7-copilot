# Nothing here is needed for the copilot itself: its settings are on the Settings tab of the page.
# This file only tells docker compose which optional containers to run.

# Optional containers: phone (virtual Android phone for PS5 screenshots), voice (speech-to-text for voice control)
# COMPOSE_PROFILES=phone,voice

# phone: Google's Android SDK and system image are downloaded on first start, under Google's terms
# (https://developer.android.com/studio/terms). "accept" accepts them.
# ANDROID_LICENSES=accept
# phone: the group that owns /dev/kvm on this machine (stat -c %g /dev/kvm)
# KVM_GID=994
# phone: the most CPU cores the phone container may use (not more than this machine has), and the cores the emulated
# phone is given (not more than PHONE_CPUS)
# PHONE_CPUS=4
# PHONE_CORES=4

# The page's port on this machine
# GT7C_HTTP_PORT=8765
