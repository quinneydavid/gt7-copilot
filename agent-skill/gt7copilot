#!/usr/bin/env python3
"""gt7copilot, the client for agents: sends one command through the copilot's agent door and prints the JSON answer.
Needs only Python. Where the copilot is and the token come from GT7C_URL and GT7C_TOKEN, or from
~/.config/gt7copilot.json  {"url": "http://machine:8765", "token": "..."}.
The token is made on the copilot's Settings tab (Agent door). `gt7copilot help` lists the commands."""
import base64, json, os, sys, urllib.error, urllib.request

FILE_ARG = {"tune-set": 2, "lib-add": 2, "know-add": 1}     # position of the JSON file argument, per command


def main(argv):
    cfg = {}
    try:
        cfg = json.load(open(os.path.expanduser("~/.config/gt7copilot.json")))
    except (OSError, ValueError):
        pass
    url = (os.environ.get("GT7C_URL") or cfg.get("url") or "").rstrip("/")
    token = os.environ.get("GT7C_TOKEN") or cfg.get("token") or ""
    if not url:
        print(json.dumps(dict(error="Where is the copilot? Set GT7C_URL or write ~/.config/gt7copilot.json")))
        return 2
    a = list(argv) or ["status"]
    try:
        if a[0] in FILE_ARG and len(a) > FILE_ARG[a[0]]:
            a[FILE_ARG[a[0]]] = json.load(open(a[FILE_ARG[a[0]]]))
        if a[0] == "shot-file" and len(a) > 1:
            a[1] = dict(image_b64=base64.b64encode(open(a[1], "rb").read()).decode())
    except (OSError, ValueError) as e:
        print(json.dumps(dict(error=f"{type(e).__name__}: {e}")))
        return 2
    req = urllib.request.Request(url + "/api/cli", json.dumps(dict(argv=a)).encode(),
                                 {"Content-Type": "application/json", "Authorization": "Bearer " + token})
    try:
        out = json.load(urllib.request.urlopen(req, timeout=240 if a[0] in ("shot", "shot-file") else 30))
    except urllib.error.HTTPError as e:
        out = json.loads(e.read() or b"{}") or dict(error=f"HTTP {e.code}")
    except OSError as e:
        out = dict(error=f"The copilot at {url} cannot be reached: {e}")
    if isinstance(out, dict) and "usage" in out and a[0] in ("help", "-h", "--help"):
        print(out["usage"]); return 0
    print(json.dumps(out, indent=1))
    return 1 if isinstance(out, dict) and out.get("error") else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
